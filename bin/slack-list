#!/usr/bin/env python3
"""讀取 Slack List，並把處理進度回報到 Slack。

只用標準函式庫，不需要安裝任何東西。
設定放在 repo 根目錄的 .env（見 .env.example）。

回報的形狀：寫進該列**原生的 item 留言串** —— PM 本來就在那裡講話。
Slack 在建列時就替每一列開好了串，這支工具只查既有串、不另建串（推導方式見 docs/adr/0001）。
  add       建立指派給自己的待辦列；同名列存在時加入既有指派
  reporter  設定該列驗收時要通知誰
  progress  只回在串裡，不 @ 人、不改狀態 —— 中間進度，不吵人
  ready     @ 回報對象，並把狀態改成「PM確認中」

「改狀態」跟「發通知」綁在同一支指令裡，不是兩件事。
拆開的話遲早會漏一次，而漏掉的症狀是表上寫 PM確認中 但沒人被通知，沒有任何徵兆。

這支檔案沒有任何刪除 Slack 內容的指令，這是刻意的。
"""

import argparse
import fcntl
import http.client
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from contextlib import contextmanager
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
API = "https://slack.com/api/"

# 這張表上用到的欄位，用「欄位名」去 schema 查 id —— 名字比 Col0B8… 好讀，
# 而且改名了會當場報錯，不會默默寫到別欄去。
# 「連結」欄不在這裡 —— 那格是 PM 放外部參考資料的地方（Google Docs、Figma…），
# 這支工具不寫它。
COL_TITLE = "名稱"
COL_DESCRIPTION = "敘述"
COL_ASSIGNEE = "指派對象"
COL_DUE = "到期日"
COL_COMPLETED = "已完成"
COL_STATUS = "狀態"
COL_FILE = "檔案"

# ready 會把狀態設成這個。表上本來就在用，語意是「球在 PM 身上」。
STATUS_READY = "PM確認中"

# 驗收報告固定四段，其中「⚠️ 要先知道的事」只有真的有行為改變才寫 —— 固定就會被硬填，
# 硬填出來的是廢話，PM 下次就整段跳過。另外三段缺一段就不准發（見 cmd_ready --report）。
REPORT_SECTIONS = ("## 改了什麼", "## 怎麼驗收", "## QA case")

# 列表指令裡，文字欄一格最多印多長。「敘述」欄佔全表輸出的 52%，放的是完整規格；
# 實測整表印出來 89KB，超過 Claude Code 的 tool result 上限就被存成檔案、只留 2KB
# preview，agent 反而要再跑好幾輪 grep 把資料撈回來（一題花了 105 秒）。
# 只截文字欄 —— 指派對象那種放多個 U… 的欄截了就沒法用眼睛比對，等於毀掉。
# 列表是用來挑出「要看哪幾列」的，全文用 `slack-list replies <record_id>` 或 --full。
CELL_LIMIT = 120

# 一則訊息裡所有 markdown block 合計的字數上限，Slack 的規格。
# 破了就改用 --md 當附件（附件沒有這個限制）。
MARKDOWN_LIMIT = 12000

# check_url 一定要自報名號。urllib 的預設 UA 是 Python-urllib/3.x，Cloudflare 的
# bot 規則會直接擋掉 —— 而分支預覽就掛在 Cloudflare Pages 上。實測同一個網址：
# Python-urllib/3.12 → 403、python-requests → 200、這個 → 200。
URL_CHECK_UA = "slack-list/1.0 (+work-helper)"

# 一頁抓幾列。這支 API 沒有任何過濾參數（只有 limit / cursor / archived），
# 所以整張表一定要翻完，能省的只有往返次數。
# 實測上限不是一個乾淨的數字，是「回應大到 1 MB 左右就會偶發被截斷」：
# limit=200 → 530 KB ok、300 → 767 KB ok、500 → 1.1 MB，第二次就 IncompleteRead。
# 200 讓 409 列從 5 次往返降到 3 次，而且離那個邊界還很遠。
PAGE_LIMIT = 200

ORIGIN_BLOCK = re.compile(r"work_helper_origin_v1_(U[A-Z0-9]+)")
REPORTER_BLOCK = re.compile(
    r"work_helper_reporter_v1_(user_(U[A-Z0-9]+)|none|default)"
)

# Slack List 的每一格會用這些鍵之一放值，看欄位型別而定
VALUE_KEYS = [
    "text", "rich_text", "number", "select", "date", "user", "channel",
    "attachment", "checkbox", "email", "phone", "rating", "timestamp",
    "link", "reference",
]

ERROR_HINTS = {
    "not_found": "找不到這張 List。要嘛 SLACK_LIST_ID 錯了，要嘛這張表還沒分享給你的 app。",
    "list_not_found": "找不到這張 List。要嘛 SLACK_LIST_ID 錯了，要嘛這張表還沒分享給你的 app。",
    "invalid_auth": "token 無效。確認 .env 裡是 xoxb- 開頭那串，而且 app 已經 Install to Workspace。",
    "not_authed": "沒帶到 token。檢查 .env 有沒有被讀到（跑 `bin/slack-list env`）。",
    "missing_scope": "app 少了這個動作需要的 scope（讀取常見 lists:read，寫入常見 lists:write / chat:write）。加完要重新 Install to Workspace，token 會換一組新的。",
    "ratelimited": "被限流了（Tier 2，每分鐘 20+ 次），等一下再跑。",
}


def die(msg):
    print(f"錯誤：{msg}", file=sys.stderr)
    sys.exit(1)


def load_env():
    f = ROOT / ".env"
    if not f.exists():
        return
    for line in f.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))


def config():
    load_env()
    token = os.environ.get("SLACK_BOT_TOKEN")
    list_id = os.environ.get("SLACK_LIST_ID")
    if not token:
        die("`.env` 裡沒有 SLACK_BOT_TOKEN")
    if not list_id:
        die("`.env` 裡沒有 SLACK_LIST_ID")
    return token, list_id


def my_user_id():
    load_env()
    uid = os.environ.get("SLACK_MY_USER_ID")
    if not uid:
        die("`.env` 裡沒有 SLACK_MY_USER_ID。"
            "Slack 點自己頭像 → 個人檔案 → 右上「⋮」→ 複製成員 ID，貼進 .env。")
    return uid


def comment_channel(list_id):
    """item 留言串住的 channel —— list id 開頭的 F 換成 C。

    沒有官方文件，是從 search.messages 回傳的 channel id 反推的（docs/adr/0001）。
    Slack 哪天改掉，conversations.info 會回 channel_not_found，不會靜默失敗。
    """
    return "C" + list_id[1:]


def api(method, payload, token):
    req = urllib.request.Request(
        API + method,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json; charset=utf-8",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            body = json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        if method == "slackLists.items.create":
            die(f"建立結果不明（HTTP {e.code}）；先到 List 搜尋同名列，勿直接重試")
        die(f"HTTP {e.code}：{e.read().decode('utf-8', 'replace')[:500]}")
    except urllib.error.URLError as e:
        if method == "slackLists.items.create":
            die(f"建立結果不明（{e.reason}）；先到 List 搜尋同名列，勿直接重試")
        die(f"連不上 Slack：{e.reason}")
    except (OSError, http.client.HTTPException, UnicodeError, json.JSONDecodeError) as e:
        if method == "slackLists.items.create":
            die(f"建立結果不明（回應中斷：{e}）；先到 List 搜尋同名列，勿直接重試")
        die(f"Slack 回應無法讀取：{e}")

    # Slack 失敗時 HTTP 仍然回 200，錯誤藏在 body.ok
    if not body.get("ok"):
        err = body.get("error", "unknown")
        print(f"Slack 回 ok:false，error = {err}", file=sys.stderr)
        if err in ERROR_HINTS:
            print(f"  → {ERROR_HINTS[err]}", file=sys.stderr)
        print(json.dumps(body, ensure_ascii=False, indent=2), file=sys.stderr)
        if (method == "slackLists.items.create"
                and err in ("internal_error", "fatal_error", "service_unavailable")):
            die("建立結果不明；先到 List 搜尋同名列，勿直接重試")
        sys.exit(1)
    return body


def api_get(method, params, token):
    """有幾支只吃 GET —— chat.getPermalink 用 POST 會回 ok:false 而且不給 error。"""
    req = urllib.request.Request(
        API + method + "?" + urllib.parse.urlencode(params),
        headers={"Authorization": f"Bearer {token}"},
        method="GET",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            body = json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        die(f"HTTP {e.code}：{e.read().decode('utf-8', 'replace')[:500]}")
    except urllib.error.URLError as e:
        die(f"連不上 Slack：{e.reason}")
    except (OSError, http.client.HTTPException, UnicodeError, json.JSONDecodeError) as e:
        die(f"Slack 回應無法讀取（{method}）：{e}")
    if not body.get("ok"):
        err = body.get("error", "unknown")
        print(f"Slack 回 ok:false（{method}），error = {err}", file=sys.stderr)
        if err in ERROR_HINTS:
            print(f"  → {ERROR_HINTS[err]}", file=sys.stderr)
        sys.exit(1)
    return body


def fetch_all():
    """把整張表撈完，自動翻頁。"""
    token, list_id = config()
    items, cursor = [], None
    while True:
        payload = {"list_id": list_id, "limit": PAGE_LIMIT}
        if cursor:
            payload["cursor"] = cursor
        body = api("slackLists.items.list", payload, token)
        # 文件寫 items，items.info 那邊叫 record，兩種都接
        items.extend(body.get("items") or body.get("records") or [])
        cursor = (body.get("response_metadata") or {}).get("next_cursor") or ""
        if not cursor:
            return items


def active_rows(items):
    """只留還沒完成、也沒被封存的列 —— 讀取指令的預設視角。

    全表 409 列裡有 234 列已完成，全印出來是 20 萬字，而 agent 每次讀進 context
    的就是那 20 萬字；只印未完成是 7 萬字。要看全部加 --all。
    「已完成的不算」在 add 的查重那邊已經是既有語意（見 active_duplicate）。
    """
    out = []
    for item in items:
        if item.get("archived"):
            continue
        done = any(f.get("key") == "todo_completed" and checkbox_value(f)
                   for f in item.get("fields") or [])
        if not done:
            out.append(item)
    return out


def scope_note(shown, total, include_done, extra=""):
    """印在 stderr 的範圍說明。

    一定要講清楚這是不是完整的表 —— 少了這句，agent 看到過濾後的結果會直接
    回「PM 沒有這件事」，而那件事只是已完成。
    """
    if include_done:
        return f"—— {extra}{shown} 列（全表 {total} 列，含已完成）"
    return (f"—— {extra}{shown} 列未完成"
            f"（全表 {total} 列；已完成的沒印，要看加 --all）")


def plain(v):
    """把一格的值壓成純文字。rich_text 是巢狀結構，遞迴撈出來。"""
    out = []

    def walk(x):
        if isinstance(x, str):
            out.append(x)
        elif isinstance(x, (int, float, bool)):
            out.append(str(x))
        elif isinstance(x, list):
            for i in x:
                walk(i)
        elif isinstance(x, dict):
            # 只走內容鍵。以前這裡是 for i in x.values()，把 "type":
            # "rich_text_section" 和內部 id 也當成文字撈進來 —— 實測那些標記
            # 佔 `slack-list todo` 輸出的 12%，而 agent 每次讀就付那 12%。
            if "text" in x:
                walk(x["text"])
            elif "elements" in x:
                walk(x["elements"])

    walk(v)
    return " ".join(s for s in (t.strip() for t in out) if s)


_COLUMN_INDEX = None


def column_index():
    """(column_id → 欄位名, 選項代碼 → 標籤)。

    多付一次 files.info，換掉輸出裡的 Col… 與 Opt… 代碼。實測那兩種 id 佔
    `slack-list todo` 輸出的 11%，而且 agent 看不懂它們是什麼欄、什麼狀態 ——
    實際發生過 agent 為了知道狀態值長怎樣跑去 grep 這支腳本的原始碼。
    """
    global _COLUMN_INDEX
    if _COLUMN_INDEX is not None:
        return _COLUMN_INDEX
    try:
        token, list_id = config()
        cols = schema(token, list_id, required=())
    except Exception as exc:  # 拿不到 schema 就退回內部 id，不要讓讀取整個掛掉
        print(f"（讀不到欄位定義，欄位名會顯示成內部 id：{exc}）", file=sys.stderr)
        _COLUMN_INDEX = ({}, {})
        return _COLUMN_INDEX
    names, labels = {}, {}
    for name, c in cols.items():
        if c.get("id"):
            names[c["id"]] = name
        for ch in ((c.get("options") or {}).get("choices") or []):
            if ch.get("value"):
                labels[ch["value"]] = ch.get("label") or ch["value"]
    _COLUMN_INDEX = (names, labels)
    return _COLUMN_INDEX


_TEXT_COLUMNS = None


def text_columns():
    """會塞長文的欄位名（schema 型別是 text / rich_text）。

    截斷只套在這些欄上。日期、select、user 欄本來就短，而 user 欄截了會把
    多個 U… 切一半，比不截還糟。
    """
    global _TEXT_COLUMNS
    if _TEXT_COLUMNS is not None:
        return _TEXT_COLUMNS
    try:
        token, list_id = config()
        cols = schema(token, list_id, required=())
    except Exception:
        _TEXT_COLUMNS = set()
        return _TEXT_COLUMNS
    _TEXT_COLUMNS = {n for n, c in cols.items()
                     if c.get("type") in ("text", "rich_text")}
    return _TEXT_COLUMNS


def cell_text(f, labels):
    """一格 → 純文字。

    只取一個值鍵。以前是把所有 VALUE_KEYS 串起來，而同一格的 text 和 rich_text
    常常都有值，於是標題整段被印兩次。
    """
    # 沒勾的核取方塊等同沒有值。預設視角本來就只有未完成，每列再印一次
    # 「已完成: False」是 175 列份的廢話。
    if "checkbox" in f:
        # 沒勾等同沒有值。預設視角本來就只有未完成，每列再印一次
        # 「已完成: False」是 175 列份的廢話。
        return "是" if checkbox_value(f) else ""
    if f.get("select"):
        vals = f["select"] if isinstance(f["select"], list) else [f["select"]]
        return " ".join(labels.get(v, str(v)) for v in vals)
    for k in VALUE_KEYS:
        v = f.get(k)
        if v in (None, [], ""):
            continue
        return plain(v)
    return ""


def flatten(item):
    """一列 → {欄位名: 純文字}"""
    names, labels = column_index()
    row = {"_id": item.get("id", "")}
    for f in item.get("fields") or []:
        cid = f.get("column_id")
        name = names.get(cid) or f.get("key") or cid or "?"
        text = cell_text(f, labels)
        if text:
            row[name] = text
    return row


# --- 回報用：查表 ---

def schema(token, list_id, required=(COL_TITLE, COL_STATUS, COL_FILE)):
    """欄位定義。slackLists.info 不存在，schema 藏在 files.info 的 list_metadata 裡。"""
    body = api_get("files.info", {"file": list_id}, token)
    cols = ((body.get("file") or {}).get("list_metadata") or {}).get("schema") or []
    by_name = {c.get("name"): c for c in cols}
    for need in required:
        if need not in by_name:
            die(f"這張表沒有「{need}」欄。有的是：{'、'.join(n for n in by_name if n)}")
    return by_name


def select_value(cols, col_name, label):
    """選項的顯示文字 → 存進去的 Opt… 代碼。"""
    choices = ((cols[col_name].get("options") or {}).get("choices")) or []
    for c in choices:
        if c.get("label") == label:
            return c["value"]
    have = "、".join(c.get("label", "") for c in choices)
    die(f"「{col_name}」沒有「{label}」這個選項。現有：{have}\n"
        "  → 選項只能在 Slack UI 加，API 加會回 missing required field: id。")


def record(token, list_id, record_id):
    """一列的原始結構。"""
    body = api("slackLists.items.info", {"list_id": list_id, "id": record_id}, token)
    return body.get("record") or body.get("item") or {}


def cell(rec, column_id):
    for f in rec.get("fields") or []:
        if f.get("column_id") == column_id:
            return f
    return {}


def record_title(rec, cols):
    # 用 text 不用 rich_text —— plain() 遞迴 rich_text 會把 type / block_id
    # 這些結構字串也一起撈出來，標題會變成「rich_text F2QiK rich_text_section 真正的標題」。
    return (cell(rec, cols[COL_TITLE]["id"]).get("text") or "").strip() or "(無標題)"


def record_reporter(rec, messages, bot_uid):
    """回傳 (user_id, 設定是否完整)；絕不從 assignee 猜回報對象。"""
    origin = ""
    setting = None
    for msg in messages:
        if not msg.get("bot_id") or msg.get("user") != bot_uid:
            continue
        for block in msg.get("blocks") or []:
            block_id = block.get("block_id") or ""
            found_origin = ORIGIN_BLOCK.fullmatch(block_id)
            if found_origin:
                origin = found_origin.group(1)
            found_setting = REPORTER_BLOCK.fullmatch(block_id)
            if found_setting:
                setting = found_setting.group(1)

    if setting and setting.startswith("user_"):
        return setting.removeprefix("user_"), True
    if setting == "none":
        return "", True

    creator = rec.get("created_by") or ""
    if creator and creator != bot_uid:
        return creator, True
    if origin:
        return origin, True
    return "", False


def deep_link(list_id, record_id):
    """表上單一列的深連結。API 不給 permalink，只能自己組。"""
    team = os.environ.get("SLACK_TEAM_ID", "T0B54FC26FR")
    return f"https://shuchenai-rdpm.slack.com/lists/{team}/{list_id}?record_id={record_id}"


def issue_mode():
    load_env()
    mode = os.environ.get("WORK_HELPER_ISSUE_MODE", "agent").strip().lower()
    if mode not in ("agent", "manual"):
        die("WORK_HELPER_ISSUE_MODE 只能是 agent 或 manual")
    return mode


# --- 回報用：找到那一列的留言串 ---

def item_threads(token, list_id):
    """record_id → 該列留言串的 parent 訊息。

    parent 由 USLACKBOT 發、`subtype: list_record_comment`，record id 在
    `slack_list.list_record_id` 裡。Slack 在建列時就開好了（實測 398 列全部都有），
    所以這是**查**不是建 —— 沒有任何情況需要我們自己開串。

    沒有快取，也不該有：這份對應關係 Slack 自己就是正本，存一份副本只會過期。
    掃完整個 channel 大約三次 API。
    """
    channel = comment_channel(list_id)
    out, cursor = {}, None
    while True:
        params = {"channel": channel, "limit": 200}
        if cursor:
            params["cursor"] = cursor
        body = api_get("conversations.history", params, token)
        for m in body.get("messages") or []:
            rid = (m.get("slack_list") or {}).get("list_record_id")
            if rid:
                out[rid] = m
        cursor = (body.get("response_metadata") or {}).get("next_cursor") or ""
        if not cursor:
            return out


def item_thread_ts(token, list_id, record_id):
    parent = item_threads(token, list_id).get(record_id)
    if not parent:
        die(f"在 {comment_channel(list_id)} 找不到 {record_id} 的留言串。\n"
            "  → 每一列都該有，找不到通常是 record_id 打錯了。")
    return parent["ts"]


def record_id_for_thread(token, list_id, channel, thread_ts):
    """OpenAB 給 channel/thread，反查它是哪一個待辦列。"""
    expected = comment_channel(list_id)
    if channel != expected:
        die(f"{channel} 不是這張 List 的 item 留言 channel（應為 {expected}）")
    for record_id, parent in item_threads(token, list_id).items():
        if parent.get("ts") == thread_ts:
            return record_id
    die(f"在 {channel} 找不到 thread_ts={thread_ts} 對應的待辦列")


def titles(items):
    """record_id → 名稱。給 replies 印標題用。"""
    out = {}
    for it in items:
        for f in it.get("fields") or []:
            if f.get("key") == "name":
                out[it.get("id", "")] = (f.get("text") or "").strip()
    return out


def bot_user_id(token):
    return api_get("auth.test", {}, token).get("user_id", "")


def check_user_id(uid, option):
    if not re.fullmatch(r"U[A-Z0-9]+", uid or ""):
        die(f"{option} 要是 U 開頭的 Slack user ID，例如 U0B54FKJ93R")


def check_date(value):
    try:
        parsed = datetime.strptime(value, "%Y-%m-%d")
    except ValueError:
        die("--due 要是 YYYY-MM-DD，例如 2026-08-21（相對日期以 Asia/Taipei 換算）")
    if parsed.strftime("%Y-%m-%d") != value:
        die("--due 要是有效的 YYYY-MM-DD 日期")


def rich_text(value):
    return [{
        "type": "rich_text",
        "elements": [{
            "type": "rich_text_section",
            "elements": [{"type": "text", "text": value}],
        }],
    }]


def normalized_title(value):
    return " ".join(value.split()).casefold()


@contextmanager
def add_lock(list_id):
    """Serialize read-then-write add operations in one runtime."""
    safe_id = re.sub(r"[^A-Za-z0-9_-]", "_", list_id)
    with Path(f"/tmp/work-helper-slack-list-add-{safe_id}.lock").open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def checkbox_value(field):
    value = field.get("checkbox", False)
    if isinstance(value, list):
        return bool(value and value[0])
    return bool(value)


def source_permalink(token, channel, thread_ts):
    if not channel and not thread_ts:
        return None
    if not channel or not thread_ts:
        die("--source-channel 和 --source-thread 必須一起提供")
    link = api_get("chat.getPermalink", {
        "channel": channel,
        "message_ts": thread_ts,
    }, token).get("permalink") or ""
    if not link:
        die("Slack 沒有傳回來源對話 permalink；未建立待辦，避免留下無來源的列")
    return link


def section_block(block_id, text):
    return {
        "type": "section",
        "block_id": block_id,
        "text": {"type": "mrkdwn", "text": text},
    }


def reporter_blocks(mode, user_id="", requester="", source=""):
    blocks = []
    if requester:
        blocks.append(section_block(
            f"work_helper_origin_v1_{requester}",
            f"由 <@{requester}> 透過 bot 建立。",
        ))
    if mode == "user":
        blocks.append(section_block(
            f"work_helper_reporter_v1_user_{user_id}",
            f"回報對象 → <@{user_id}>",
        ))
    elif mode == "default":
        blocks.append(section_block(
            "work_helper_reporter_v1_default",
            "回報對象 → 恢復預設",
        ))
    else:
        blocks.append(section_block(
            "work_helper_reporter_v1_none",
            "回報對象 → 不指定",
        ))
    if source:
        blocks.append(section_block("work_helper_source_v1", f"來源對話：{source}"))
    return blocks


def post_note_with_retry(token, list_id, record_id, text, blocks=None):
    """新列的原生 thread 可能稍晚出現；找不到時短暫重試，不刪已建立的列。"""
    for attempt in range(3):
        try:
            parent = item_threads(token, list_id).get(record_id)
            if parent:
                payload = {
                    "channel": comment_channel(list_id),
                    "thread_ts": parent["ts"],
                    "text": text,
                }
                if blocks:
                    payload["blocks"] = blocks
                api("chat.postMessage", payload, token)
                return True
        except SystemExit:
            return False
        if attempt < 2:
            time.sleep(1)
    return False


def post_record_note(token, list_id, record_id, requester, reporter, source):
    lines = []
    if requester:
        lines.extend([
            f"[work-helper:origin:v1 sender={requester}]",
            f"由 <@{requester}> 透過 bot 建立。",
        ])
    if reporter:
        lines.extend([
            f"[work-helper:reporter:v1 user={reporter}]",
            f"回報對象 → <@{reporter}>",
        ])
    else:
        lines.extend([
            "[work-helper:reporter:v1 none]",
            "回報對象 → 不指定",
        ])
    if source:
        lines.append(f"來源對話：{source}")
    mode = "user" if reporter else "none"
    blocks = reporter_blocks(mode, reporter or "", requester or "", source or "")
    return post_note_with_retry(token, list_id, record_id, "\n".join(lines), blocks)


def post_duplicate_note(token, list_id, record_id, sender, source):
    lines = [f"<@{sender}> 再次回報同一件事；既有待辦已指派給他。"]
    if source:
        lines.append(f"來源對話：{source}")
    return post_note_with_retry(token, list_id, record_id, "\n".join(lines))


def upload_md(token, channel, thread_ts, path):
    """把 md 傳進留言串，回傳 file_id。同一個 id 之後也放得進 list 的檔案欄。"""
    p = Path(path)
    if not p.exists():
        die(f"找不到 {p}")
    data = p.read_bytes()
    slot = api_get("files.getUploadURLExternal",
                   {"filename": p.name, "length": str(len(data))}, token)
    req = urllib.request.Request(slot["upload_url"], data=data,
                                 headers={"Content-Type": "application/octet-stream"})
    try:
        urllib.request.urlopen(req, timeout=60).read()
    except urllib.error.URLError as e:
        die(f"檔案上傳失敗：{e.reason}")
    api("files.completeUploadExternal", {
        "files": [{"id": slot["file_id"], "title": p.stem}],
        "channel_id": channel, "thread_ts": thread_ts,
    }, token)
    return slot["file_id"]


def report_body(path, url=None):
    """讀驗收報告，檢查模板，回傳要當 markdown block 發出去的內文。

    H1 標題與「測試網址：」那行會被拿掉 —— 訊息本身已經有標題連結和測試連結欄，
    留著就是同一則訊息裡講兩遍。檔案自己留著它們是對的（單獨打開時才看得懂）。
    """
    p = Path(path)
    if not p.exists():
        die(f"找不到 {p}")
    text = p.read_text(encoding="utf-8")

    missing = [h for h in REPORT_SECTIONS
               if not re.search(rf"^{re.escape(h)}", text, re.M)]
    if missing:
        die(f"{p} 少了：{'、'.join(missing)}\n"
            "驗收報告固定四段 —— 改了什麼／⚠️ 要先知道的事（有才寫）／怎麼驗收／QA case。")

    # ⬜ 是「這項要人工看」，後面必須寫為什麼測不到；只打一個框 PM 分不出
    # 那是漏掉還是刻意不測。（✅ 有沒有真的跑過測試，腳本驗不了，那是 skill 的規矩。）
    # 逐格看，不是逐行 —— 表格結尾那個 | 不算原因
    bare = [ln.strip() for ln in text.splitlines() if "⬜" in ln and any(
        "⬜" in cell and not cell.replace("⬜", "").strip()
        for cell in ln.split("|"))]
    if bare:
        die(f"{p} 有 {len(bare)} 列只打了 ⬜ 沒寫原因，第一列是：{bare[0]}\n"
            "⬜ 後面要寫為什麼測不到。")

    lines = []
    for line in text.splitlines():
        stripped = line.strip()
        if not lines and (not stripped or stripped.startswith("# ")
                          or stripped.startswith("測試網址")):
            continue
        lines.append(line)
    body = "\n".join(lines).strip()
    if len(body) > MARKDOWN_LIMIT:
        die(f"{p} 有 {len(body)} 字，超過 Slack 一則訊息的 {MARKDOWN_LIMIT} 字上限。"
            "拆短，或改用 --md 當附件發。")

    if url:
        for line in text.splitlines():
            if line.strip().startswith("測試網址") and url not in line:
                print(f"提醒：{p} 裡的測試網址跟 --url 給的不一樣。", file=sys.stderr)
                break
    return body


# --- 指令 ---

def cmd_raw():
    print(json.dumps(fetch_all(), ensure_ascii=False, indent=2))


def cmd_count():
    print(len(fetch_all()))


def cmd_sample():
    items = fetch_all()
    if not items:
        die("這張表是空的（或 bot 讀不到任何一列）")
    print(json.dumps(items[0], ensure_ascii=False, indent=2))


def cmd_fields():
    """這張表有哪些欄、什麼型別、select 欄可以填哪些值。

    以 files.info 的 schema 為正本（含一列都沒填過的欄），再用實際資料補
    「有值的列數」與範例。

    不列出選項的話 --where 等於沒用：agent 不知道「狀態」能填什麼，只好先把
    整表撈下來再自己 grep 統計 —— 實際發生過，那一題花了 105 秒。
    """
    token, list_id = config()
    cols = schema(token, list_id, required=())
    _, labels = column_index()

    stats = {}
    for item in fetch_all():
        for f in item.get("fields") or []:
            e = stats.setdefault(f.get("column_id"), {"n": 0, "sample": ""})
            text = cell_text(f, labels)
            if not text:
                continue
            e["n"] += 1
            if not e["sample"]:
                e["sample"] = one_line(text, 80)

    out = []
    for name, c in cols.items():
        e = stats.get(c.get("id")) or {"n": 0, "sample": ""}
        entry = {"欄位": name, "型別": c.get("type"), "有值的列數": e["n"]}
        choices = ((c.get("options") or {}).get("choices")) or []
        if choices:
            entry["可填的值"] = [ch.get("label") or ch.get("value") for ch in choices]
        elif e["sample"]:
            entry["範例"] = e["sample"]
        out.append(entry)

    print(json.dumps(out, ensure_ascii=False, indent=2))
    print("—— 有「可填的值」的欄位可以直接下 slack-list rows --where 欄位=值；"
          "其他欄位是子字串比對。", file=sys.stderr)


def one_line(text, limit=None):
    """一格 → 單行。換行壓成空格；limit 有給就再截斷。

    不壓換行的話「一行一列」是假的：敘述欄的換行會讓任何以行為單位的統計算錯，
    實際發生過 agent 把 114（行）當成列數，真值是 40。
    """
    text = " ".join(text.split())
    if limit and len(text) > limit:
        return text[:limit].rstrip() + "…"
    return text


def format_row(row, full=False):
    """flatten() 後的一列 → 一行輸出。--full 原樣印，含換行。"""
    row = dict(row)
    rid = row.pop("_id", "")
    if full:
        cells = " ｜ ".join(f"{k}: {v}" for k, v in row.items())
    else:
        long_cols = text_columns()
        cells = " ｜ ".join(
            f"{k}: {one_line(v, CELL_LIMIT if k in long_cols else None)}"
            for k, v in row.items())
    return f"[{rid}] {cells}"


def print_rows(rows, full=False, columns=None):
    """rows 是 flatten() 之後的 dict。columns 有給就只印那幾欄。"""
    for row in rows:
        if columns:
            row = {k: v for k, v in row.items() if k == "_id" or k in columns}
        print(format_row(row, full))


def all_flag(parser):
    parser.add_argument("--all", action="store_true",
                        help="連已完成的列也印（預設只印未完成）")
    return parser


def full_flag(parser):
    parser.add_argument("--full", action="store_true",
                        help=f"印每一格的完整內容（預設壓成單行並截到 {CELL_LIMIT} 字）")
    return parser


def cmd_todo(argv):
    """人和 agent 都看得懂的一行一列。"""
    args = full_flag(all_flag(argparse.ArgumentParser(
        prog="slack-list todo",
        description="一行一列。預設只印未完成的列。"))).parse_args(argv)
    rows = fetch_all()
    shown = rows if args.all else active_rows(rows)
    print_rows([flatten(i) for i in shown], args.full)
    print(scope_note(len(shown), len(rows), args.all), file=sys.stderr)


def cmd_json(argv):
    """壓平後的 JSON，給下游程式吃。"""
    args = all_flag(argparse.ArgumentParser(
        prog="slack-list json",
        description="壓平後的 JSON。預設只印未完成的列。")).parse_args(argv)
    rows = fetch_all()
    shown = rows if args.all else active_rows(rows)
    print(json.dumps([flatten(i) for i in shown], ensure_ascii=False, indent=2))
    print(scope_note(len(shown), len(rows), args.all), file=sys.stderr)


def print_assigned(uid, kw="", include_done=False, full=False):
    """印出指派給指定 Slack 使用者的列，可再比對整列關鍵字。"""
    if not re.fullmatch(r"U[A-Z0-9]+", uid):
        die("Slack user ID 要是 U 開頭，例如 U0B54FKJ93R")
    items = fetch_all()
    rows = [flatten(i) for i in (items if include_done else active_rows(items))]
    assigned = [r for r in rows
                if uid in (r.get(COL_ASSIGNEE) or r.get("todo_assignee") or "").split()]
    if kw:
        assigned = [r for r in assigned if kw in json.dumps(r, ensure_ascii=False)]
    print_rows(assigned, full)
    scope = f"指派給 {uid}" + (f" 且含「{kw}」" if kw else "") + "："
    print("\n" + scope_note(len(assigned), len(items), include_done, scope),
          file=sys.stderr)


def resolve_column(name, fields):
    """使用者給的欄位名 → 實際欄位名。

    允許只給一部分，因為欄位是 PM 在 Slack UI 上維護的，名字會變。
    對不到就把可用欄位全部印出來 —— 空結果和打錯欄位名長得一樣。
    """
    name = name.strip()
    hit = [f for f in fields if name.lower() == f.lower()]
    if not hit:
        hit = [f for f in fields if name.lower() in f.lower()]
    if not hit:
        die(f"這個範圍裡沒有「{name}」這個欄位。有的是：{'、'.join(fields)}")
    if len(hit) > 1:
        die(f"「{name}」對到多個欄位：{'、'.join(hit)}。給完整一點的名字。")
    return hit[0]


def resolve_where(expr, fields):
    """`欄位=值` → (實際欄位名, 值)。"""
    if "=" not in expr:
        die(f"--where 要寫成「欄位=值」，收到的是：{expr}")
    name, value = expr.split("=", 1)
    return resolve_column(name, fields), value.strip()


def cmd_users(argv):
    """人名 → Slack user ID。

    表上只存 user ID，所以「whales 建立的那些」這種問題一定要先解析人名。
    這支用 bot token 的 users:read 做，不要改用 claude.ai 的 Slack connector ——
    那條路是用另一個人的 Slack 身分，不受這張表的權限邊界約束。
    """
    ap = argparse.ArgumentParser(
        prog="slack-list users",
        description="用關鍵字找 Slack 成員，印出 user ID。比對帳號、顯示名稱與全名。")
    ap.add_argument("keyword", help="姓名或帳號的一部分，不分大小寫")
    ap.add_argument("--all", action="store_true", help="連停用帳號與 bot 也印")
    args = ap.parse_args(argv)

    token, _ = config()
    kw = args.keyword.lower()
    hits, cursor = [], None
    while True:
        params = {"limit": 200}
        if cursor:
            params["cursor"] = cursor
        body = api_get("users.list", params, token)
        for m in body.get("members") or []:
            if not args.all and (m.get("deleted") or m.get("is_bot")):
                continue
            prof = m.get("profile") or {}
            names = [m.get("name") or "", m.get("real_name") or "",
                     prof.get("display_name") or "", prof.get("real_name") or ""]
            if any(kw in n.lower() for n in names if n):
                hits.append((m.get("id"), prof.get("display_name") or m.get("name") or "",
                             prof.get("real_name") or m.get("real_name") or ""))
        cursor = (body.get("response_metadata") or {}).get("next_cursor") or ""
        if not cursor:
            break

    for uid, disp, real in hits:
        print(f"{uid}\t{disp}\t{real}")
    if not hits:
        print(f"找不到符合「{args.keyword}」的成員。", file=sys.stderr)
    elif len(hits) > 1:
        print(f"—— {len(hits)} 個符合。人名可能重複，用哪一個要先確認，不要猜。",
              file=sys.stderr)


def cmd_rows(argv):
    """一支查詢指令，條件用 flag 疊加。

    todo / mine / assigned 是它的三個特例，保留成別名。條件不放在子指令名字裡，
    是因為每多一個條件就要多一支子指令，而 skill 也得多教一套語法。
    """
    ap = full_flag(all_flag(argparse.ArgumentParser(
        prog="slack-list rows",
        description="查待辦列，條件可疊加。預設只印未完成。",
        epilog="例：slack-list rows --assignee U0B8ASE0ARX --where 狀態=PM確認。"
               "欄位有哪些值先看 slack-list fields")))
    ap.add_argument("--assignee", metavar="U…", help="指派對象包含這個 Slack user ID")
    ap.add_argument("--created-by", dest="created_by", metavar="U…",
                    help="這一列的建立者。注意 bot 代建的列建立者是 bot，"
                         "要找某人「要求建立」的列請用 --assignee")
    ap.add_argument("--columns", metavar="欄位,欄位",
                    help="只印這幾欄，逗號分隔。結果多的時候先用這個把「敘述」拿掉——"
                         "它佔全表輸出的一半。例：--columns 名稱,狀態")
    ap.add_argument("--where", action="append", default=[], metavar="欄位=值",
                    help="任一欄位的子字串比對，可重複。例：--where 類別=bug "
                         "--where 狀態=PM確認。欄位名可以只給一部分")
    ap.add_argument("keyword", nargs="?", default="", help="可選，比對整列文字")
    args = ap.parse_args(argv)

    items = fetch_all()
    pool = items if args.all else active_rows(items)
    pairs = [(it, flatten(it)) for it in pool]

    fields = sorted({k for _, row in pairs for k in row if k != "_id"})
    conds = [resolve_where(w, fields) for w in args.where]

    picked = []
    for item, row in pairs:
        if args.assignee and args.assignee not in (row.get(COL_ASSIGNEE) or "").split():
            continue
        if args.created_by and item.get("created_by") != args.created_by:
            continue
        if any(v.lower() not in (row.get(k) or "").lower() for k, v in conds):
            continue
        if args.keyword and args.keyword not in json.dumps(row, ensure_ascii=False):
            continue
        picked.append(row)

    cols = None
    if args.columns:
        cols = [resolve_column(c, fields) for c in args.columns.split(",") if c.strip()]
    print_rows(picked, args.full, cols)

    scope = "、".join(x for x in [
        f"指派給 {args.assignee}" if args.assignee else "",
        f"建立者 {args.created_by}" if args.created_by else "",
        *[f"{k} 含「{v}」" for k, v in conds],
        f"含「{args.keyword}」" if args.keyword else "",
    ] if x)
    print("\n" + scope_note(len(picked), len(items), args.all,
                            (scope + "：") if scope else ""), file=sys.stderr)

    # 打錯值時，空結果和「真的沒有」長得一樣。把該欄實際出現過的值印出來 ——
    # 但只在低基數時列舉；欄位有幾百種值的話列出來又是一份雜訊。
    if not picked:
        for k, _ in conds:
            seen = {}
            for _, row in pairs:
                seen[row.get(k) or "(空白)"] = seen.get(row.get(k) or "(空白)", 0) + 1
            ranked = sorted(seen.items(), key=lambda kv: -kv[1])
            if len(ranked) <= 25:
                detail = "、".join(f"{v}×{n}" for v, n in ranked)
                print(f"   「{k}」在這個範圍裡出現過：{detail}", file=sys.stderr)
            else:
                top = "、".join(f"{v}×{n}" for v, n in ranked[:5])
                print(f"   「{k}」有 {len(ranked)} 種值，最常見：{top}", file=sys.stderr)


