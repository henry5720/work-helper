    ap.add_argument("keyword", nargs="?", default="", help="可選，過濾整列文字")
    args = ap.parse_args(argv)
    print_assigned(args.user_id, args.keyword, args.all, args.full)


def active_duplicate(rows, title, cols):
    wanted = normalized_title(title)
    matches = []
    for row in rows:
        if row.get("archived"):
            continue
        if checkbox_value(cell(row, cols[COL_COMPLETED]["id"])):
            continue
        if normalized_title(record_title(row, cols)) == wanted:
            matches.append(row)
    if len(matches) > 1:
        ids = "、".join(r.get("id", "?") for r in matches)
        die(f"找到多筆同名且未完成的待辦列（{ids}），先人工合併，工具不會猜該更新哪一筆")
    return matches[0] if matches else None


def add_or_merge(args, token, list_id, cols, title, source):
    rows = fetch_all()
    duplicate = None if args.force else active_duplicate(rows, title, cols)
    if duplicate:
        record_id = duplicate["id"]
        ready_opt = select_value(cols, COL_STATUS, STATUS_READY)
        statuses = cell(duplicate, cols[COL_STATUS]["id"]).get("select") or []
        if ready_opt in statuses:
            print(f"已有同名待辦正在 {STATUS_READY}，未變更指派：")
            print(deep_link(list_id, record_id))
            if args.report_to or args.no_reporter:
                print("既有列的回報對象也未變更；確認後請另用 reporter 指令設定。")
            print("若這是復發或另一件事，確認後加 --force 重新執行。")
            return

        assignee_cell = cell(duplicate, cols[COL_ASSIGNEE]["id"])
        assignees = list(assignee_cell.get("user") or [])
        if args.assignee not in assignees:
            assignees.append(args.assignee)
            api("slackLists.items.update", {
                "list_id": list_id,
                "id": record_id,
                "cells": [{
                    "row_id": record_id,
                    "column_id": cols[COL_ASSIGNEE]["id"],
                    "user": assignees,
                }],
            }, token)
            result = "已加入既有待辦"
        else:
            result = "既有待辦已指派給你"
        noted = post_duplicate_note(
            token, list_id, record_id, args.assignee, source)
        print(f"{result}：{title}")
        if args.report_to or args.no_reporter:
            print("命中既有列，未變更原回報對象；要修改請另用 reporter 指令。")
        if not noted:
            print("待辦指派已更新，但再次回報的來源註記失敗。")
        print(deep_link(list_id, record_id))
        return

    initial_fields = [
        {"column_id": cols[COL_TITLE]["id"], "rich_text": rich_text(title)},
        {"column_id": cols[COL_ASSIGNEE]["id"], "user": [args.assignee]},
    ]
    if args.description:
        initial_fields.append({
            "column_id": cols[COL_DESCRIPTION]["id"],
            "rich_text": rich_text(args.description.strip()),
        })
    if args.due:
        initial_fields.append({
            "column_id": cols[COL_DUE]["id"],
            "date": [args.due],
        })

    body = api("slackLists.items.create", {
        "list_id": list_id,
        "initial_fields": initial_fields,
    }, token)
    created = body.get("item") or body.get("record") or {}
    record_id = created.get("id") or ""
    if not record_id:
        die("Slack 回報建立成功，但沒有傳回 record ID；先到 List 確認，勿直接重試")

    reporter = "" if args.no_reporter else (args.report_to or args.requested_by)
    noted = post_record_note(
        token, list_id, record_id, args.requested_by, reporter, source)
    print(f"已新增：{title}")
    if args.due:
        print(f"到期日：{args.due}")
    if not noted:
        print("待辦已建立，但來源／回報設定失敗；這列之後不會猜回報對象。")
    print(deep_link(list_id, record_id))


def cmd_add(argv):
    """建立 self-assigned 待辦；精確同名時加入既有列。"""
    ap = argparse.ArgumentParser(
        prog="slack-list add",
        description="建立待辦並指派給當次使用者；同名未完成待辦存在時加入既有指派。")
    ap.add_argument("--title", required=True, help="待辦名稱；不會自行補模組前綴")
    ap.add_argument("--description", help="敘述（可選）")
    ap.add_argument("--due", help="到期日，YYYY-MM-DD（Asia/Taipei）")
    ap.add_argument("--assignee", required=True, metavar="SLACK_USER_ID",
                    help="要加入指派的 Slack user ID")
    ap.add_argument("--requested-by", required=True, metavar="SLACK_USER_ID",
                    help="OpenAB sender ID；必須和 --assignee 相同")
    report = ap.add_mutually_exclusive_group()
    report.add_argument("--report-to", metavar="SLACK_USER_ID",
                        help="回報對象；省略時預設 requested-by")
    report.add_argument("--no-reporter", action="store_true",
                        help="明確不指定回報對象")
    ap.add_argument("--source-channel", required=True,
                    help="OpenAB sender context 的 channel_id")
    ap.add_argument("--source-thread", required=True,
                    help="OpenAB sender context 的 thread_id")
    ap.add_argument("--force", action="store_true",
                    help="使用者已確認這是另一件事；略過同名合併與 item thread 防護")
    args = ap.parse_args(argv)

    title = args.title.strip()
    if not title:
        die("--title 不能是空白")
    if args.due:
        check_date(args.due)
    check_user_id(args.assignee, "--assignee")
    check_user_id(args.requested_by, "--requested-by")
    if args.requested_by != args.assignee:
        die("共享 agent 只能把新待辦指派給當次 sender；--assignee 必須等於 --requested-by")
    if args.report_to:
        check_user_id(args.report_to, "--report-to")
    token, list_id = config()
    cols = schema(token, list_id, required=(
        COL_TITLE, COL_DESCRIPTION, COL_ASSIGNEE, COL_DUE, COL_COMPLETED, COL_STATUS,
    ))

    if (args.source_channel == comment_channel(list_id) and not args.force):
        source_row = next((rid for rid, parent in item_threads(token, list_id).items()
                           if parent.get("ts") == args.source_thread), None)
        if source_row:
            print("目前在既有待辦列的 item 留言串；先確認準備新增的是另一件事：")
            print(deep_link(list_id, source_row))
            print(f"準備新增：{title}")
            print("確認後用同一組參數加 --force。")
            return

    source = source_permalink(token, args.source_channel, args.source_thread)
    with add_lock(list_id):
        add_or_merge(args, token, list_id, cols, title, source)


def reporter_message(mode, user_id=""):
    if mode == "user":
        return (f"[work-helper:reporter:v1 user={user_id}]\n"
                f"回報對象 → <@{user_id}>")
    if mode == "default":
        return "[work-helper:reporter:v1 default]\n回報對象 → 恢復預設"
    return "[work-helper:reporter:v1 none]\n回報對象 → 不指定"


def cmd_reporter(argv):
    """在 item 留言串留下可見、可解析的回報設定。"""
    ap = argparse.ArgumentParser(
        prog="slack-list reporter",
        description="設定一列驗收時要通知的人；最新一則設定生效。")
    ap.add_argument("record_id", help="表上那一列的 ID（Rec… 開頭）")
    choice = ap.add_mutually_exclusive_group(required=True)
    choice.add_argument("--user", metavar="SLACK_USER_ID", help="指定一位回報對象")
    choice.add_argument("--default", action="store_true",
                        help="恢復預設：真人建立者或 bot 建列發起者")
    choice.add_argument("--none", action="store_true", help="明確不通知任何人")
    args = ap.parse_args(argv)
    if args.user:
        check_user_id(args.user, "--user")

    token, list_id = config()
    ts = item_thread_ts(token, list_id, args.record_id)
    mode = "user" if args.user else ("default" if args.default else "none")
    api("chat.postMessage", {
        "channel": comment_channel(list_id),
        "thread_ts": ts,
        "text": reporter_message(mode, args.user or ""),
        "blocks": reporter_blocks(mode, args.user or ""),
    }, token)
    label = f"<@{args.user}>" if args.user else ("預設" if args.default else "不指定")
    print(f"回報對象 → {label}")
    print(deep_link(list_id, args.record_id))


def cmd_progress(argv):
    """中間進度：只回在留言串裡，不 @ 人、不改狀態。"""
    ap = argparse.ArgumentParser(
        prog="slack-list progress",
        description="把一句進度回在該列的 item 留言串裡。不會 @ 任何人，也不改狀態。")
    ap.add_argument("record_id", help="表上那一列的 ID（Rec… 開頭，`mine` / `assigned` 印在最前面）")
    ap.add_argument("note", help="一句話說現在做到哪")
    args = ap.parse_args(argv)

    token, list_id = config()
    channel = comment_channel(list_id)
    cols = schema(token, list_id)
    rec = record(token, list_id, args.record_id)
    ts = item_thread_ts(token, list_id, args.record_id)
    api("chat.postMessage",
        {"channel": channel, "thread_ts": ts, "text": args.note}, token)

    print(f"已回報：{record_title(rec, cols)}")
    print(deep_link(list_id, args.record_id))


def compact_message(msg):
    files = [f.get("name") or f.get("title") or f.get("id")
             for f in (msg.get("files") or [])]
    return {
        "ts": msg.get("ts", ""),
        "user": msg.get("user", ""),
        "bot_id": msg.get("bot_id", ""),
        "text": msg.get("text", ""),
        "files": files,
    }


def cmd_context(argv):
    """用 OpenAB sender context 的 channel/thread 取得完整待辦列 context。"""
    ap = argparse.ArgumentParser(
        prog="slack-list context",
        description="用 Slack channel ID 與 thread_ts 反查待辦列，輸出該列和留言串 JSON。")
    ap.add_argument("--channel", required=True, help="OpenAB sender context 的 channel_id")
    ap.add_argument("--thread-ts", required=True, help="OpenAB sender context 的 thread_id")
    args = ap.parse_args(argv)

    token, list_id = config()
    record_id = record_id_for_thread(token, list_id, args.channel, args.thread_ts)
    item = next((i for i in fetch_all() if i.get("id") == record_id), None)
    if not item:
        die(f"留言串對應 {record_id}，但待辦列已不存在")
    messages = [compact_message(m) for m in thread_messages(
        token, args.channel, args.thread_ts) if not is_parent(m)]
    print(json.dumps({
        "record_id": record_id,
        "link": deep_link(list_id, record_id),
        "channel_id": args.channel,
        "thread_ts": args.thread_ts,
        "record": flatten(item),
        "messages": messages,
    }, ensure_ascii=False, indent=2))


def github_issue_urls(repo, record_id, title):
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo):
        die("--repo 要是 owner/repo，例如 ShuChenAI/teamsync-frontend")
    base = f"https://github.com/{repo}/issues"
    search = base + "?" + urllib.parse.urlencode({"q": f'is:issue "{record_id}"'})
    create = base + "/new?" + urllib.parse.urlencode({"title": title})
    return search, create


def cmd_draft(argv):
    """把 issue 草稿交到 item 留言串；不 @ 人、不改狀態。"""
    ap = argparse.ArgumentParser(
        prog="slack-list draft",
        description="上傳 issue 草稿到 item 留言串，附查重與建立 issue 連結；不改狀態。")
    ap.add_argument("record_id", help="表上那一列的 ID（Rec… 開頭）")
    ap.add_argument("--md", required=True, metavar="檔案", help="完整 issue body 草稿")
    ap.add_argument("--repo", required=True, help="建議發布到的 GitHub owner/repo")
    ap.add_argument("--summary", required=True, help="給核准者看的短摘要")
    ap.add_argument("--requested-by", metavar="SLACK_USER_ID",
                    help="OpenAB sender context 的 sender_id（U…）")
    args = ap.parse_args(argv)

    token, list_id = config()
    channel = comment_channel(list_id)
    cols = schema(token, list_id)
    rec = record(token, list_id, args.record_id)
    title = record_title(rec, cols)
    ts = item_thread_ts(token, list_id, args.record_id)
    search_url, create_url = github_issue_urls(args.repo, args.record_id, title)

    upload_md(token, channel, ts, args.md)
    requester = f"\n發起者：<@{args.requested_by}>" if args.requested_by else ""
    text = (
        f"*Issue 草稿待核准* — {title}{requester}\n"
        f"{args.summary}\n"
        f"建議 repo：`{args.repo}`\n"
        f"<{search_url}|先用指紋查重> · <{create_url}|確認後到 GitHub 建立 issue>\n"
        "完整 body 在同一串的 Markdown 附件。這一步不會建立 GitHub issue。"
    )
    api("chat.postMessage", {"channel": channel, "thread_ts": ts, "text": text}, token)
    print(f"草稿已交付：{title}")
    print(deep_link(list_id, args.record_id))
    print(search_url)
    print(create_url)


def thread_messages(token, channel, ts):
    """一條串的全部訊息（含主訊息），自動翻頁。"""
    out, cursor = [], None
    while True:
        params = {"channel": channel, "ts": ts, "limit": 200}
        if cursor:
            params["cursor"] = cursor
        body = api_get("conversations.replies", params, token)
        out.extend(body.get("messages") or [])
        cursor = (body.get("response_metadata") or {}).get("next_cursor") or ""
        if not cursor:
            return out


def is_ours(msg):
    """bot 自己發的。人回的訊息沒有 bot_id。"""
    return bool(msg.get("bot_id"))


def is_parent(msg):
    """留言串的 parent 是 Slack 自己塞的佔位訊息（文字固定是 A comment was added）。"""
    return msg.get("subtype") == "list_record_comment"


def when(msg):
    stamp = float(msg.get("ts", 0))
    return datetime.fromtimestamp(stamp).strftime("%m/%d %H:%M")


def cmd_replies(argv):
    """讀 item 留言串 —— PM 講的話都在這裡。"""
    ap = argparse.ArgumentParser(
        prog="slack-list replies",
        description="讀某一列 item 留言串的內容。不帶 record_id 就掃過整張表，"
                    "只列出「有別人回過」的那幾列。")
    ap.add_argument("record_id", nargs="?", help="表上那一列的 ID（Rec… 開頭）")
    ap.add_argument("--all", action="store_true",
                    help="連 bot 自己發的也印出來（預設只印別人回的）")
    args = ap.parse_args(argv)

    token, list_id = config()
    channel = comment_channel(list_id)

    if not args.record_id:
        # parent 訊息本身就帶 reply_count / reply_users / latest_reply，
        # 所以掃全表不用逐條打開 —— 開 398 條串會直接撞到限流。
        me = bot_user_id(token)
        name_of = titles(fetch_all())
        parents = item_threads(token, list_id)
        found = 0
        for rid, p in sorted(parents.items(),
                             key=lambda kv: kv[1].get("latest_reply") or "", reverse=True):
            if rid not in name_of:      # 表上已經刪掉的列，parent 還留著
                continue
            others = [u for u in (p.get("reply_users") or []) if u != me]
            if not others:
                continue
            found += 1
            last = p.get("latest_reply")
            stamp = datetime.fromtimestamp(float(last)).strftime("%m/%d %H:%M") if last else "?"
            print(f"[{rid}] {name_of[rid] or '(無標題)'} —— {p.get('reply_count', 0)} 則，最後 {stamp}")
            print(f"  {'、'.join('<@%s>' % u for u in others)}")
            print(f"  {deep_link(list_id, rid)}")
        print(f"\n—— 表上 {len(name_of)} 列，{found} 列有別人回過", file=sys.stderr)
        return

    ts = item_thread_ts(token, list_id, args.record_id)
    msgs = [m for m in thread_messages(token, channel, ts) if not is_parent(m)]
    shown = msgs if args.all else [m for m in msgs if not is_ours(m)]
    print(f"{deep_link(list_id, args.record_id)}")
    if not shown:
        print("（沒有人回過。加 --all 看 bot 自己發的。）")
        return
    for m in shown:
        who = "bot" if is_ours(m) else f"<@{m.get('user', '?')}>"
        print(f"\n── {when(m)} {who}")
        files = [f.get("name") or f.get("title") or f.get("id")
                 for f in (m.get("files") or [])]
        print(m.get("text") or (f"[附件] {'、'.join(files)}" if files else "(沒有純文字內容)"))


def probe_url(url, method):
    """問一次網址，回 (狀態碼, 錯誤說明)。連不到時狀態碼是 None。"""
    req = urllib.request.Request(url, method=method,
                                 headers={"User-Agent": URL_CHECK_UA})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return resp.status, None
    except urllib.error.HTTPError as e:
        return e.code, None
    except Exception as exc:
        return None, str(exc)


def check_url(url):
    """發出去之前先確認測試連結連得到。貼一個連不到的網址給 PM，比沒貼還糟。"""
    if not re.match(r"^https?://", url):
        die(f"測試連結要以 http:// 或 https:// 開頭，收到的是：{url}")
    bad = f"確認部署好了沒（分支預覽要 CI 跑完才會有），或是這一列本來就沒有預覽環境 —— 那就用 --no-url。"
    code, err = probe_url(url, "HEAD")
    if code is None or code >= 400:
        # 有些站不收 HEAD（405），Cloudflare 對非瀏覽器的 HEAD 也會直接回 4xx。
        # GET 問到的才算數 —— 只認 405 的話，活著的網址會被判成死的。
        code2, err2 = probe_url(url, "GET")
        if code2 is not None:
            code, err = code2, None
        elif code is None:
            err = err or err2
    if code is None:
        die(f"測試連結連不到（{err}）：{url}\n{bad}")
    if code >= 400:
        die(f"測試連結回 HTTP {code}：{url}\n{bad}")


def cmd_ready(argv):
    """可驗收：@ 回報對象，並把狀態改成 PM確認中。"""
    ap = argparse.ArgumentParser(
        prog="slack-list ready",
        description="通知 PM 可以驗收，並把狀態改成「%s」。兩件事一起做，不能只做一半。" % STATUS_READY,
        epilog="例：slack-list ready Rec0B… "
               "--url https://fix-xxx.teamsync-frontend.pages.dev "
               "--report drafts/2026-08-19/reports/report-1786-stock-status.md")
    ap.add_argument("record_id", help="表上那一列的 ID（Rec… 開頭）")
    ap.add_argument("--report", metavar="檔案",
                    help="驗收報告 md，整份當訊息本體發出去（固定四段，缺段就不發）")
    ap.add_argument("--changed", action="append", metavar="一句話",
                    help="沒有畫面可看的單（後端、純文件）才用：改了什麼，白話，可重複")
    ap.add_argument("--verify", action="append", metavar="步驟",
                    help="沒有畫面可看的單才用：怎麼驗收，一步一個，可重複")
    ap.add_argument("--md", metavar="檔案",
                    help="另外附一份檔案，會一併進「檔案」欄。報告本體用 --report")
    # 測試連結沒有預設值，也不自己從 branch 推 —— 這支是在 work-helper 目錄底下跑的，
    # cwd 早就離開專案 repo，git 問到的會是 work-helper 自己的 branch。
    # 二選一而且沒有預設，是為了讓「忘記附連結」變成跑不動，而不是發出去才發現。
    url_g = ap.add_mutually_exclusive_group(required=True)
    url_g.add_argument("--url", metavar="網址",
                       help="測試連結（分支預覽環境）。發出去之前會先確認連得到")
    url_g.add_argument("--no-url", action="store_true",
                       help="這一列沒有預覽環境可看（後端單、純文件單）")
    ap.add_argument("--quiet", action="store_true",
                    help="不 @ 人，只留在串裡。批次補狀態時用")
    args = ap.parse_args(argv)
    # --report 已經包含改了什麼與怎麼驗收，再給 flag 就是同一件事寫兩遍，
    # 而寫兩遍遲早會不一致 —— 所以擋掉，不合併。
    if args.report and (args.changed or args.verify):
        die("--report 已經包含改了什麼與怎麼驗收，不要再給 --changed／--verify")
    if not args.report and not (args.changed and args.verify):
        die("要嘛 --report <md>（前端單都走這條），"
            "要嘛 --changed 與 --verify 都給（後端單、純文件單）")
    report = report_body(args.report, args.url) if args.report else None
    if args.url:
        check_url(args.url)  # 連不到就中止，不要留下「通知發了但連結是死的」

    token, list_id = config()
    channel = comment_channel(list_id)
    cols = schema(token, list_id)
    ready_opt = select_value(cols, COL_STATUS, STATUS_READY)
    rec = record(token, list_id, args.record_id)
    title = record_title(rec, cols)
    link = deep_link(list_id, args.record_id)
    ts = item_thread_ts(token, list_id, args.record_id)

    messages = thread_messages(token, channel, ts)
    who, reporter_known = record_reporter(rec, messages, bot_user_id(token))
    mention = f"<@{who}>" if who and not args.quiet else ""
    if not reporter_known and not args.quiet:
        print(f"提醒：「{title}」查不到可靠的回報對象，這則不會 @ 到任何人。", file=sys.stderr)

    head = (f"{mention} 可以驗收了 → <{link}|{title}>" if mention
            else f"可以驗收了 → <{link}|{title}>")
    blocks = [{"type": "section", "text": {"type": "mrkdwn", "text": head}}]
    if report:
        # markdown block 才吃 pipe table —— QA case 那張表是整份報告的重點，
        # 用 section 的 mrkdwn 發會散成一堆 |。這個 block 只能用在訊息裡。
        blocks.append({"type": "markdown", "text": report})
    else:
        blocks += [
            {"type": "section",
             "text": {"type": "mrkdwn",
                      "text": "*改了什麼*\n" + "\n".join(args.changed)}},
            {"type": "rich_text", "elements": [
                {"type": "rich_text_section",
                 "elements": [{"type": "text", "text": "怎麼驗收",
                               "style": {"bold": True}}]},
                {"type": "rich_text_list", "style": "ordered", "elements": [
                    {"type": "rich_text_section",
                     "elements": [{"type": "text", "text": v}]} for v in args.verify]},
            ]},
        ]
    if args.url:
        blocks.append({"type": "section", "text": {
            "type": "mrkdwn", "text": f"*測試連結*\n{args.url}"}})
    # 先發訊息、後改狀態。反過來的話訊息發失敗會留下「表上寫 PM確認中 但沒人被通知」，
    # 那正是這支指令要防的事；這個順序最壞只會留下「通知了但狀態沒動」，看得見。
    # 不 broadcast —— item 留言串沒有 channel 主畫面可以冒，通知全靠上面那個 @。
    api("chat.postMessage", {
        "channel": channel, "thread_ts": ts,
        "text": f"{title} 可以驗收了", "blocks": blocks,
    }, token)

    cells = [{"row_id": args.record_id, "column_id": cols[COL_STATUS]["id"],
              "select": [ready_opt]}]
    if args.md:
        file_id = upload_md(token, channel, ts, args.md)
        old = cell(rec, cols[COL_FILE]["id"]).get("attachment") or []
        cells.append({"row_id": args.record_id, "column_id": cols[COL_FILE]["id"],
                      "attachment": old + [file_id]})
    api("slackLists.items.update",
        {"list_id": list_id, "id": args.record_id, "cells": cells}, token)

    print(f"已通知{'（quiet，沒 @ 人）' if args.quiet else ''}：{title}")
    print(f"狀態 → {STATUS_READY}")
    if args.md:
        print(f"附件 → 留言串 + 「{COL_FILE}」欄：{args.md}")
    print(link)


def cmd_env():
    load_env()
    token = os.environ.get("SLACK_BOT_TOKEN", "")
    list_id = os.environ.get("SLACK_LIST_ID", "")
    my_id = os.environ.get("SLACK_MY_USER_ID", "")
    masked = f"{token[:9]}…{token[-4:]}" if len(token) > 15 else ("(沒設定)" if not token else "(太短，可能貼錯)")
    print(f".env       : {ROOT / '.env'}（{'有' if (ROOT / '.env').exists() else '不存在'}）")
    print(f"TOKEN      : {masked}")
    print(f"LIST_ID    : {list_id or '(沒設定)'}")
    print(f"MY_USER_ID : {my_id or '(沒設定，mine 指令會不能用)'}")
    print(f"ISSUE_MODE : {issue_mode()}")
    print(f"留言串 channel : {comment_channel(list_id) if list_id else '(要先設 LIST_ID)'}")


READ_COMMANDS = {
    "raw": (cmd_raw, "Slack 原始回應，完整不加工"),
    "sample": (cmd_sample, "只印第一列的原始結構"),
    "fields": (cmd_fields, "這張表有哪些欄位、什麼型別、select 欄可以填哪些值"),
    "count": (cmd_count, "共幾列"),
    "env": (cmd_env, "檢查設定有沒有讀到（token 會遮起來）"),
}

# 這幾支自己吃參數，各自有 --help
ARG_READ_COMMANDS = {
    "users": (cmd_users, "人名關鍵字 → Slack user ID（查 --assignee/--created-by 要用）"),
    "rows": (cmd_rows, "查待辦列，--assignee/--created-by/--where 欄位=值/關鍵字可疊加"),
    "todo": (cmd_todo, "一行一列，人看的（預設）；只印未完成，--all 看全部"),
    "mine": (cmd_mine, "只印指派給我的未完成列，可多帶一個關鍵字再過濾"),
    "json": (cmd_json, "壓平後的 JSON，給程式吃；只印未完成，--all 看全部"),
    "assigned": (cmd_assigned, "只印指派給指定 Slack user ID 的列，可再加關鍵字"),
    "replies": (cmd_replies, "讀 item 留言串；不帶 record_id 就掃出「有別人回過」的那幾列"),
    "context": (cmd_context, "用 OpenAB channel/thread 反查待辦列與完整留言"),
}

WRITE_COMMANDS = {
    "add": (cmd_add, "建立 self-assigned 待辦；同名未完成列存在時加入既有指派"),
    "reporter": (cmd_reporter, "設定、恢復或取消一列的回報對象"),
    "progress": (cmd_progress, "回一句進度到該列的 item 留言串，不吵人"),
    "draft": (cmd_draft, "交付 issue 草稿附件與人工發布連結，不改狀態"),
    "ready": (cmd_ready, f"通知可以驗收 + 狀態改成「{STATUS_READY}」"),
}


def usage():
    print("用法：slack-list <指令> [參數]\n")
    print("讀取：")
    # 常用的先印 —— todo 是預設指令，不該排在 raw / sample 後面
    for k, (_, desc) in ARG_READ_COMMANDS.items():
        print(f"  {k:<9} {desc}")
    for k, (_, desc) in READ_COMMANDS.items():
        print(f"  {k:<9} {desc}")
    print("\n寫入 Slack（詳細參數看 `slack-list <指令> --help`）：")
    for k, (_, desc) in WRITE_COMMANDS.items():
        print(f"  {k:<9} {desc}")


def main():
    name = sys.argv[1] if len(sys.argv) > 1 else "todo"
    if name in ("-h", "--help", "help"):
        usage()
        sys.exit(0)
    if name in ARG_READ_COMMANDS:
        ARG_READ_COMMANDS[name][0](sys.argv[2:])
        return
    if name in WRITE_COMMANDS:
        WRITE_COMMANDS[name][0](sys.argv[2:])
        return
    if name not in READ_COMMANDS:
        usage()
        sys.exit(1)
    READ_COMMANDS[name][0]()


if __name__ == "__main__":
    main()
